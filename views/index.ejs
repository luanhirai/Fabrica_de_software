<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>App Demo - Informações do Servidor</title>
  <style>
    .server-time {
      color: #b42318;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <h1>Informações do Servidor</h1>
  <p>Endereço IP do Servidor: <%= ip %></p>
  <p>Data e hora do servidor:
    <% if (horaAtualDisponivel) { %>
      <strong class="server-time"><%= horaAtual %></strong>
    <% } else { %>
      <span role="status">Data e hora indisponíveis no momento.</span>
    <% } %>
  </p>
</body>
</html>
